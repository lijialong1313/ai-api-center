<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.weacsoft</groupId>
    <artifactId>ai-api-center</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>ai-api-center</name>
    <description>基于 jaravel-vendor 的多模式 vLLM 排队中间件</description>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jaravel.version>0.1.3</jaravel.version>
    </properties>

    <dependencies>
        <!-- jaravel-vendor 聚合 Starter：core / http / springboot / auth / database / migration / cache / storage / event / artisan / schedule -->
        <dependency>
            <groupId>io.github.lijialong1313</groupId>
            <artifactId>starter</artifactId>
            <version>${jaravel.version}</version>
        </dependency>

        <!-- 管理后台模板引擎（Blade） -->
        <dependency>
            <groupId>io.github.lijialong1313</groupId>
            <artifactId>jblade</artifactId>
            <version>${jaravel.version}</version>
        </dependency>

        <!-- JWT 认证（auth 的可选守卫驱动） -->
        <dependency>
            <groupId>io.github.lijialong1313</groupId>
            <artifactId>jwt</artifactId>
            <version>${jaravel.version}</version>
        </dependency>

        <!-- 队列驱动：sync / database / redis 三选一，按部署模式装配 -->
        <dependency>
            <groupId>io.github.lijialong1313</groupId>
            <artifactId>queue-database</artifactId>
            <version>${jaravel.version}</version>
        </dependency>

        <!-- Redis 连接管理 + 分布式锁（有 Redis 部署模式） -->
        <dependency>
            <groupId>io.github.lijialong1313</groupId>
            <artifactId>redis</artifactId>
            <version>${jaravel.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.lijialong1313</groupId>
            <artifactId>redis-cache</artifactId>
            <version>${jaravel.version}</version>
        </dependency>

        <!-- Web 容器（starter 中为 optional，应用侧显式引入） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 数据库驱动：默认 SQLite（单机零配置），生产可切 MySQL -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 校验（统一身份认证回包校验用） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>ai-api-center</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
        </resources>
    </build>
</project>
